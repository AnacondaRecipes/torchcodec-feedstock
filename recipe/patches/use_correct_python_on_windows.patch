From 702de21fd9a9c1cb6165fba3d37cd051d9e5837f Mon Sep 17 00:00:00 2001
From: Silvio Traversaro <silvio@traversaro.it>
Date: Tue, 9 Sep 2025 08:54:27 +0200
Subject: [PATCH] Add workaround for conda-forge pkg-config issue

Added a workaround for conda-forge pkg-config issue.

Refreshed for 0.16.0, which grew a find_package(Python3) call of its own right
after project(); the overrides have to be set before it runs.
---
 CMakeLists.txt | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 384cb22..a5207d1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,6 +1,10 @@
 cmake_minimum_required(VERSION 3.18)
 project(TorchCodec)
 
+set(PYTHON_EXECUTABLE $ENV{PYTHON})
+set(Python_EXECUTABLE $ENV{PYTHON})
+set(Python3_EXECUTABLE $ENV{PYTHON})
+
 # Define LINUX platform variable globally
 if (UNIX AND NOT APPLE)
     set(LINUX TRUE)
